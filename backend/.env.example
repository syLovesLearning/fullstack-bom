# ==============================================================================
# backend/.env — 本地运行配置（已切换至智谱 glm-5.3-flash + 向量本地降级）
# ==============================================================================

# 1. 数据库与缓存连接
PG_DSN=postgresql://shenyang@localhost:5432/rag_db
REDIS_URL=redis://localhost:6379/0

# 2. 鉴权 JWT 配置（生产环境请务必更换 JWT_SECRET）
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 3. 对话与推理模型（智谱 GLM-5.3-Flash）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_api_key
LLM_MODEL=glm-5.3-flash

# 4. 向量模型独立配置（当前设为 local 跳过 429 额度限制；日后接 Ollama 可改为 http://localhost:11434/v1 + bge-m3）
EMBED_BASE_URL=
EMBED_API_KEY=local
EMBED_MODEL=embedding-3

# 5. 前端跨域白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
